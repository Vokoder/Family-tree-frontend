    {
      "semi": true,
      "trailingComma": "all",
      "singleQuote": true,
      "printWidth": 120,
      "tabWidth": 2,
      "jsxSingleQuote": true,
      "endOfLine": "auto",
      "plugins": [
        "@trivago/prettier-plugin-sort-imports"
      ],
      "importOrder": [
        "^react",
        "^antd",
        "<THIRD_PARTY_MODULES>",
        "^[./]"
      ],
      "importOrderSeparation": true
    }